# Mobile app points at the FastAPI service. Set an address reachable from your device.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Optional Supabase project configuration for production auth and database access.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_EAS_PROJECT_ID=

# Backend-only values. Never put these in EXPO_PUBLIC_* variables.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DEV_MODE=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
PLACE_PROVIDER_USER_AGENT=TouchGrass/1.0 (contact: configure-in-production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/calendar/google/callback
GOOGLE_OAUTH_STATE_SECRET=
TOKEN_ENCRYPTION_KEY=
APP_DEEP_LINK=touchgrass://calendar/complete
EXPO_PUSH_ACCESS_TOKEN=
